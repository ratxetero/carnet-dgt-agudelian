<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Resultados' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container">

<%
  const total = test.num_preguntas || 0;
  const pct = total > 0 ? Math.round((test.aciertos / total) * 100) : 0;
  const minutos = test.tiempo_segundos ? Math.floor(test.tiempo_segundos / 60) : 0;
  const segundos = test.tiempo_segundos ? test.tiempo_segundos % 60 : 0;
%>

    <div class="veredicto <%= test.aprobado ? '' : 'derrota' %>">
      <span class="rotulo"><%= test.aprobado ? 'Apto' : 'No apto' %></span>
      <span class="subrotulo"><%= test.aciertos %> de <%= total %> aciertos · <%= pct %>%</span>
    </div>

    <div class="panel-marcador">
      <div class="celda ok">
        <span class="valor"><%= test.aciertos %></span>
        <span class="etiqueta">Aciertos</span>
      </div>
      <div class="celda fail">
        <span class="valor"><%= test.fallos %></span>
        <span class="etiqueta">Fallos</span>
      </div>
      <div class="celda">
        <span class="valor"><%= test.en_blanco %></span>
        <span class="etiqueta">En blanco</span>
      </div>
    </div>

    <div class="card">
      <div class="hud-etiquetas">
        <span>Nota del test</span>
        <b><%= pct %>%</b>
      </div>
      <div class="barra-energia <%= pct < 90 ? 'baja' : '' %>">
        <div class="pista"><div class="carga" style="width:<%= pct %>%"></div></div>
      </div>
      <p class="mt-2" style="margin-bottom:0;">
        <% if (test.aprobado) { %>
          Superado. En el examen real se aprueba con 27 de 30, y aquí has fallado <%= test.fallos %>.
        <% } else { %>
          No superado. Se necesitan 27 de 30: te han faltado <%= Math.max(0, 27 - test.aciertos) %> aciertos.
        <% } %>
        <% if (test.tiempo_segundos) { %>Tiempo: <%= minutos %> min <%= segundos %> s.<% } %>
      </p>
      <div class="acciones-resultado" style="justify-content:flex-start;">
        <a href="/test/nuevo" class="btn"><i data-lucide="<%= test.aprobado ? 'play' : 'rotate-ccw' %>" class="icon"></i> <%= test.aprobado ? 'Otro test' : 'Repasar fallos' %></a>
        <a href="/" class="btn secundario">Panel</a>
      </div>
    </div>

    <% if (desglosePorTema && desglosePorTema.length) { %>
      <div class="card">
        <h2>Desglose por tema</h2>
        <% desglosePorTema.forEach(function(d){
             const dTotal = (d.aciertos||0) + (d.fallos||0) + (d.en_blanco||0);
             const dPct = dTotal > 0 ? Math.round((d.aciertos / dTotal) * 100) : 0; %>
          <div class="fila-energia">
            <div class="fila-cab">
              <span class="fila-nombre"><%= d.tema_numero ? ('Tema ' + d.tema_numero + ' — ' + d.tema_nombre) : d.tema_nombre %></span>
              <span class="fila-cifra"><%= d.aciertos %>/<%= dTotal %></span>
            </div>
            <div class="barra-energia <%= dPct < 70 ? 'baja' : '' %>">
              <div class="pista"><div class="carga" style="width:<%= dPct %>%"></div></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="card">
      <h2>Revisión de preguntas</h2>
      <% detalle.forEach(function(p, i){ %>
        <div class="revision-pregunta">
          <div class="cab">
            <span class="num">Nº <%= String(i + 1).padStart(2, '0') %></span>
            <% if (p.esCorrecta === null) { %><span class="badge neutro">Sin responder</span>
            <% } else if (p.esCorrecta) { %><span class="badge ok"><i data-lucide="check" class="icon-sm"></i> Correcta</span>
            <% } else { %><span class="badge fail"><i data-lucide="x" class="icon-sm"></i> Incorrecta</span><% } %>
          </div>
          <% if (p.imagen) { %><img class="pregunta-imagen" style="max-height:180px;" src="/images/preguntas/<%= p.imagen %>" alt="" /><% } %>
          <p class="enunciado"><%= p.enunciado %></p>
          <ul class="revision-opciones">
            <% p.opciones.forEach(function(op){ %>
              <li class="<%= op.es_correcta ? 'correcta' : (op.id === p.opcionElegidaId ? 'elegida-mal' : '') %>">
                <span class="marca">
                  <% if (op.es_correcta) { %><i data-lucide="check" class="icon-sm" style="color:var(--success);"></i>
                  <% } else if (op.id === p.opcionElegidaId) { %><i data-lucide="x" class="icon-sm" style="color:var(--danger);"></i><% } %>
                </span>
                <span><%= op.texto %>
                  <% if (op.explicacion) { %><span class="explica"><%= op.explicacion %></span><% } %>
                </span>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>

    <div class="flex-between">
      <a href="/test/nuevo" class="btn">Hacer otro test</a>
      <a href="/" class="btn secundario">Volver al panel</a>
    </div>
  </div>
</body>
</html>
