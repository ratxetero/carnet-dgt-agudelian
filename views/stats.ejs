<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Estadísticas' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container-ancho">
    <div class="mt-1" style="margin-bottom:14px;">
      <div class="eyebrow">Progreso</div>
      <h1>Estadísticas</h1>
    </div>

    <div class="grid-donuts">
      <div class="card tarjeta-donut">
        <h2>Aciertos globales</h2>
        <div class="donut-wrap"><canvas id="donut-aciertos"></canvas></div>
        <div class="leyenda-donut" id="leyenda-aciertos"></div>
      </div>
      <div class="card tarjeta-donut">
        <h2>Resultado de tests</h2>
        <div class="donut-wrap"><canvas id="donut-aptos"></canvas></div>
        <div class="leyenda-donut" id="leyenda-aptos"></div>
      </div>
    </div>

    <div class="card">
      <h2>Aciertos por tema</h2>
      <p class="text-muted" style="margin-top:-4px;">"T0" corresponde a las preguntas sin categorizar.</p>
      <div class="chart-wrap"><canvas id="chart-temas" height="120"></canvas></div>
    </div>

    <div class="card">
      <h2>Simulacros oficiales</h2>
      <div style="overflow-x:auto;">
      <table class="tabla-simple" id="tabla-oficiales">
        <thead><tr><th>Simulacro</th><th>Intentos</th><th>Mejor resultado</th><th>¿Aprobado?</th></tr></thead>
        <tbody></tbody>
      </table>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
  <script src="/js/stats.js"></script>
</body>
</html>
