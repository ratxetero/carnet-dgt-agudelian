<script>
  (function () {
    try {
      var guardado = localStorage.getItem('tema');
      var tema = guardado || ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'oscuro' : 'claro');
      document.documentElement.setAttribute('data-tema', tema);
    } catch (e) {}
  })();
</script>
