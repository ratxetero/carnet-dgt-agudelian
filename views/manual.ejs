<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Manual' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container-ancho">

    <div class="cabecera-alumno">
      <span class="rol">Consulta</span>
      <h1>Manual</h1>
    </div>

    <div class="manual-cabecera">
      <p class="text-muted" style="margin:0;">Permiso B, sin salir de la aplicación<% if (tamanoMB) { %> · <%= tamanoMB %> MB<% } %></p>
      <% if (existe) { %>
        <div class="acciones-manual">
          <a href="<%= urlPdf %>" target="_blank" rel="noopener" class="btn"><i data-lucide="maximize-2" class="icon"></i> Pantalla completa</a>
          <a href="/manual/descargar" class="btn secundario"><i data-lucide="download" class="icon"></i> Descargar</a>
        </div>
      <% } %>
    </div>

    <% if (!existe) { %>
      <div class="estado-vacio">
        <div class="icono-vacio"><i data-lucide="file-x" class="icon-lg"></i></div>
        <h3>Todavía no hay un manual cargado</h3>
        <p>
          Coloca un archivo PDF en <code>public/pdf/manual.pdf</code> (sustituyendo el que hubiera)
          y recarga esta página. No hay que cambiar nada de código.
        </p>
      </div>
    <% } else { %>

      <div class="visor-pdf-wrap">
        <iframe src="<%= urlPdf %>" title="Manual teórico DGT" loading="lazy"></iframe>
      </div>
      <p class="text-muted mt-2" style="display:none;" id="aviso-visor-desktop">
        ¿No se ve bien el visor? <a href="<%= urlPdf %>" target="_blank" rel="noopener">Ábrelo a pantalla completa</a> o descárgalo con el botón de arriba.
      </p>

      <div class="manual-solo-movil">
        <div class="card" style="text-align:center;">
          <div class="icono-vacio" style="margin:0 auto 14px; color:var(--accent); display:flex; justify-content:center;"><i data-lucide="smartphone" class="icon-lg"></i></div>
          <h3>Léelo a pantalla completa</h3>
          <p class="text-muted">
            En el móvil el manual se abre en el visor de PDF nativo del navegador: más
            cómodo y fiable. Desde ahí puedes buscar texto, hacer zoom y guardarlo.
          </p>
          <a href="<%= urlPdf %>" target="_blank" rel="noopener" class="btn grande">Abrir manual</a>
          <a href="/manual/descargar" class="btn secundario grande mt-1" style="display:flex;">Descargar PDF</a>
        </div>
      </div>
    <% } %>
  </div>

  <script>
    (function () {
      var aviso = document.getElementById('aviso-visor-desktop');
      if (aviso) setTimeout(function () { aviso.style.display = 'block'; }, 2500);
    })();
  </script>
</body>
</html>
