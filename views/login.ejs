<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Iniciar sesión' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container" style="max-width:520px;">
    <div class="auth-columna">

      <div class="auth-marquesina">
        <span class="titulo">Test teórico<br />Alejandro</span>
        <span class="sub">Permiso B · DGT</span>
      </div>

      <form class="form-auth" method="POST" action="/login">
        <div class="moneda">
          <div class="ranura"></div>
          <span class="texto">Inserta moneda</span>
        </div>

        <% if (errores && errores.length) { %>
          <div class="errores"><i data-lucide="alert-circle" class="icon-sm" style="margin-top:2px;"></i><div><% errores.forEach(function(e){ %><div><%= e %></div><% }) %></div></div>
        <% } %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="campo">
          <label for="username">Usuario o email</label>
          <input type="text" id="username" name="username" value="<%= valores.username || '' %>" required autofocus />
        </div>
        <div class="campo">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" required />
        </div>

        <button type="submit" class="btn grande mt-1"><i data-lucide="log-in" class="icon"></i> Entrar</button>
      </form>

      <p class="auth-pie">¿No tienes cuenta? <a href="/register">Crear cuenta</a></p>
    </div>
  </div>
</body>
</html>
