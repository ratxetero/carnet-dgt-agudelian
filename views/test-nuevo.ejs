<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Nuevo test' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container">
    <h1>Elige el tipo de test</h1>
    <% if (error) { %><div class="errores"><%= error %></div><% } %>

    <form method="POST" action="/test/iniciar" id="form-nuevo-test">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="tipo" id="input-tipo" />
      <input type="hidden" name="bloque_id" id="input-bloque-id" />
      <input type="hidden" name="tema_id" id="input-tema-id" />

      <div class="modo-selector">
        <div class="modo-card" data-tipo="aleatorio">
          <h3><span class="icono-modo"><i data-lucide="shuffle" class="icon"></i></span> Test aleatorio</h3>
          <p>30 preguntas de todo el temario, formato simulacro oficial.</p>
        </div>
        <div class="modo-card" data-tipo="tema">
          <h3><span class="icono-modo"><i data-lucide="book-open" class="icon"></i></span> Test por tema</h3>
          <p>Elige un tema y un bloque de hasta 30 preguntas de ese tema.</p>
        </div>
        <div class="modo-card" data-tipo="oficial">
          <h3><span class="icono-modo"><i data-lucide="clipboard-check" class="icon"></i></span> Simulacro oficial</h3>
          <p>30 preguntas reales agrupadas en el formato del examen oficial DGT.</p>
        </div>
        <div class="modo-card" data-tipo="repaso">
          <h3><span class="icono-modo"><i data-lucide="rotate-ccw" class="icon"></i></span> Repaso de fallos</h3>
          <p>Repite las preguntas que has fallado antes (<%= totalFallos %> en total).</p>
        </div>
      </div>

      <!-- Test por tema: paso 1 = elegir tema, paso 2 = elegir bloque de ese tema -->
      <div id="panel-tema" style="display:none;">
        <h2 class="mt-2">1. Elige un tema</h2>
        <div class="modo-selector" id="grid-temas"></div>
        <div id="paso-bloques" style="display:none;">
          <h2 class="mt-2">2. Elige el test</h2>
          <div class="modo-selector" id="grid-bloques"></div>
        </div>
      </div>

      <!-- Simulacro oficial: elegir directamente uno de los generados -->
      <div id="panel-oficial" style="display:none;">
        <h2 class="mt-2">Elige un simulacro</h2>
        <div class="modo-selector" id="grid-simulacros"></div>
      </div>

      <!-- Repaso de fallos: elegir "todos" o un tema concreto -->
      <div id="panel-repaso" style="display:none;">
        <h2 class="mt-2">¿Repasar todo o un tema concreto?</h2>
        <div class="modo-selector" id="grid-repaso"></div>
      </div>

      <button type="submit" class="btn grande mt-2" id="btn-empezar" disabled>Selecciona una opción para empezar</button>
    </form>
  </div>

  <script>
    window.__TEMAS__ = <%- JSON.stringify(temas) %>;
    window.__BLOQUES_POR_TEMA__ = <%- JSON.stringify(bloquesPorTema) %>;
    window.__SIMULACROS__ = <%- JSON.stringify(simulacros) %>;
    window.__TOTAL_FALLOS__ = <%- JSON.stringify(totalFallos) %>;
  </script>
  <script src="/js/test-nuevo.js"></script>
</body>
</html>
