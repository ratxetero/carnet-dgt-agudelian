# Copia este archivo como .env y ajusta los valores si lo necesitas
PORT=3000
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga
DB_PATH=./database/carnet.db
NODE_ENV=development

# --- Chat "Consulta a un experto" (IA) ---
# Necesario para que funcione el botón "Consulta a un experto". Crea una
# cuenta gratuita en https://openrouter.ai, genera una API key (no requiere
# tarjeta) y pégala aquí. Sin esta clave, el botón sigue apareciendo pero
# muestra un mensaje explicando que falta configurar esto.
OPENROUTER_API_KEY=

# Modelo a usar. Por defecto "openrouter/free" (el enrutador automático de
# OpenRouter, que elige un modelo :free disponible en cada momento — el
# catálogo de modelos gratuitos cambia con frecuencia, así que esto evita
# tener que actualizar el código cuando un modelo concreto deja de estar
# disponible). Puedes fijar un modelo concreto si prefieres, por ejemplo:
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free

# URL pública de la app (opcional, solo se envía como cabecera informativa a OpenRouter)
APP_URL=http://localhost:3000
