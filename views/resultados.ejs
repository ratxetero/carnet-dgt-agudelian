<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Resultados' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container">
    <h1>Resultados del test</h1>

<%
  const radio = 74;
  const circunferencia = 2 * Math.PI * radio;
  const fraccion = test.num_preguntas > 0 ? test.aciertos / test.num_preguntas : 0;
  const offset = circunferencia * (1 - fraccion);
  const colorAro = test.aprobado ? 'var(--success)' : 'var(--danger)';
%>
    <div class="card" style="text-align:center;">
      <div class="marcador-resultado">
        <svg width="180" height="180" viewBox="0 0 180 180">
          <circle cx="90" cy="90" r="<%= radio %>" fill="none" stroke="var(--border)" stroke-width="14" />
          <circle cx="90" cy="90" r="<%= radio %>" fill="none" stroke="<%= colorAro %>" stroke-width="14"
                  stroke-linecap="round" stroke-dasharray="<%= circunferencia %>" stroke-dashoffset="<%= offset %>"
                  transform="rotate(-90 90 90)" style="transition: stroke-dashoffset 0.6s ease;" />
          <text x="90" y="85" text-anchor="middle" class="numero-central"><%= test.aciertos %>/<%= test.num_preguntas %></text>
          <text x="90" y="108" text-anchor="middle" class="etiqueta-central">aciertos</text>
        </svg>
      </div>
      <div class="badge <%= test.aprobado ? 'ok' : 'fail' %>" style="font-size:0.95rem; margin-top:4px;">
        <i data-lucide="<%= test.aprobado ? 'check-circle-2' : 'x-circle' %>" class="icon-sm"></i>
        <%= test.aprobado ? 'APTO' : 'NO APTO' %>
      </div>
      <p class="text-muted mt-2">
        Aciertos: <%= test.aciertos %> · Fallos: <%= test.fallos %> · En blanco: <%= test.en_blanco %>
        <% if (test.tiempo_segundos) { %> · Tiempo: <%= Math.floor(test.tiempo_segundos/60) %> min <%= test.tiempo_segundos%60 %> s<% } %>
      </p>
    </div>

    <div class="card">
      <h2>Desglose por tema</h2>
      <div style="overflow-x:auto;">
      <table class="tabla-simple">
        <thead><tr><th>Tema</th><th>Aciertos</th><th>Fallos</th><th>En blanco</th></tr></thead>
        <tbody>
          <% desglosePorTema.forEach(function(d){ %>
            <tr>
              <td><%= d.tema_numero ? ('Tema ' + d.tema_numero + ' — ' + d.tema_nombre) : d.tema_nombre %></td>
              <td><%= d.aciertos %></td>
              <td><%= d.fallos %></td>
              <td><%= d.en_blanco %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>

    <div class="card">
      <h2>Revisión de preguntas</h2>
      <% detalle.forEach(function(p, i){ %>
        <div class="card" style="background:var(--surface-sunken); box-shadow:none;">
          <div class="flex-between">
            <strong>Pregunta <%= i + 1 %></strong>
            <% if (p.esCorrecta === null) { %><span class="badge neutro">Sin responder</span>
            <% } else if (p.esCorrecta) { %><span class="badge ok"><i data-lucide="check" class="icon-sm"></i> Correcta</span>
            <% } else { %><span class="badge fail"><i data-lucide="x" class="icon-sm"></i> Incorrecta</span><% } %>
          </div>
          <% if (p.imagen) { %><img class="pregunta-imagen" style="max-height:200px;" src="/images/preguntas/<%= p.imagen %>" alt="" /><% } %>
          <p><%= p.enunciado %></p>
          <ul style="list-style:none; padding:0;">
            <% p.opciones.forEach(function(op){ %>
              <li style="padding:9px 11px; border-radius:8px; margin-bottom:6px;
                background: <%= op.es_correcta ? 'var(--success-soft)' : (op.id === p.opcionElegidaId ? 'var(--danger-soft)' : 'var(--surface)') %>;
                border: 1px solid var(--border);">
                <div class="flex-icon"><%= op.texto %>
                  <% if (op.es_correcta) { %><i data-lucide="check" class="icon-sm" style="color:var(--success);"></i>
                  <% } else if (op.id === p.opcionElegidaId) { %><i data-lucide="x" class="icon-sm" style="color:var(--danger);"></i><% } %>
                </div>
                <% if (op.explicacion) { %>
                  <div class="text-muted" style="margin-top:4px; font-size:0.85rem;"><%= op.explicacion %></div>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>

    <div class="flex-between">
      <a href="/test/nuevo" class="btn">Hacer otro test</a>
      <a href="/" class="btn secundario">Volver al inicio</a>
    </div>
  </div>
</body>
</html>
