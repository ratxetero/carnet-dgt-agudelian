<script>
  // Se ejecuta lo antes posible para fijar el tema (claro/oscuro) antes de
  // la primera pintura y evitar el parpadeo de tema incorrecto.
  (function () {
    try {
      var guardado = localStorage.getItem('tema');
      var tema = guardado || ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'oscuro' : 'claro');
      document.documentElement.setAttribute('data-tema', tema);
    } catch (e) {}
  })();
</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
