<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Nuevo test' }) %></head>
<body class="pantalla-pasos">
  <%- include('partials/nav') %>

  <!-- Flujo por pasos: una decisión por pantalla, sin scroll de página. -->
  <div class="paso-shell">
    <header class="paso-cabecera">
      <button type="button" class="btn-hud" id="btn-paso-atras" aria-label="Paso anterior"><i data-lucide="arrow-left" class="icon-sm"></i></button>
      <div class="titulos">
        <span class="paso-contador" id="paso-contador">Paso 1 de 2</span>
        <span class="paso-titulo" id="paso-titulo">Tipo de test</span>
      </div>
      <a class="btn-hud salir" href="/" aria-label="Salir" title="Salir"><i data-lucide="x" class="icon-sm"></i></a>
    </header>

    <div class="paso-progreso" id="paso-progreso" aria-hidden="true"></div>

    <% if (error) { %><div class="errores"><i data-lucide="alert-octagon" class="icon"></i> <%= error %></div><% } %>

    <form method="POST" action="/test/iniciar" id="form-nuevo-test" style="display:contents;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="tipo" id="input-tipo" />
      <input type="hidden" name="bloque_id" id="input-bloque-id" />
      <input type="hidden" name="tema_id" id="input-tema-id" />

      <div class="paso-cuerpo" id="paso-cuerpo"></div>

      <footer class="paso-pie">
        <button type="submit" class="btn grande" id="btn-empezar" disabled>Elige una opción</button>
      </footer>
    </form>
  </div>

  <script>
    window.__TEMAS__ = <%- JSON.stringify(temas) %>;
    window.__BLOQUES_POR_TEMA__ = <%- JSON.stringify(bloquesPorTema) %>;
    window.__SIMULACROS__ = <%- JSON.stringify(simulacros) %>;
    window.__TOTAL_FALLOS__ = <%- JSON.stringify(totalFallos) %>;
  </script>
  <script src="/js/test-nuevo.js"></script>
</body>
</html>
