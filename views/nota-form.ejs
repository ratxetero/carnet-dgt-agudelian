<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: nota ? 'Editar nota' : 'Nueva nota' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container">

    <div class="cabecera-alumno">
      <span class="rol">Cuaderno</span>
      <h1><%= nota ? 'Editar nota' : 'Nueva nota' %></h1>
    </div>

    <% if (error) { %><div class="errores"><i data-lucide="alert-octagon" class="icon"></i> <%= error %></div><% } %>

    <form method="POST" action="<%= nota ? `/cuaderno/${nota.id}/editar` : '/cuaderno/nueva' %>" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <% if (pregunta) { %>
        <input type="hidden" name="pregunta_id" value="<%= pregunta.id %>" />
        <div class="explicacion-box" style="margin:0 0 18px;">
          <strong>Vinculada a la pregunta</strong><br />
          <%= pregunta.enunciado %>
        </div>
      <% } %>

      <div class="campo-form">
        <label for="titulo">Título</label>
        <input type="text" id="titulo" name="titulo" value="<%= nota ? nota.titulo : '' %>" placeholder="Título breve (opcional)" />
      </div>

      <div class="campo-form">
        <label for="contenido">Contenido</label>
        <textarea id="contenido" name="contenido" rows="8" required placeholder="Escribe tu nota..."><%= nota ? nota.contenido : '' %></textarea>
      </div>

      <div class="grid-2">
        <div class="campo-form">
          <label for="tema_id">Tema (opcional)</label>
          <select id="tema_id" name="tema_id">
            <option value="">Sin tema</option>
            <% temas.forEach(function(t){ %>
              <option value="<%= t.id %>" <%= (nota && nota.tema_id === t.id) ? 'selected' : '' %>>Tema <%= t.numero %> — <%= t.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div class="campo-form">
          <label for="categoria">Categoría (opcional)</label>
          <input type="text" id="categoria" name="categoria" value="<%= nota ? (nota.categoria || '') : '' %>" placeholder="p. ej. Dudas, Repaso" />
        </div>
      </div>

      <div class="campo-form">
        <label for="etiquetas">Etiquetas (separadas por comas)</label>
        <input type="text" id="etiquetas" name="etiquetas" value="<%= nota ? (nota.etiquetas || '') : '' %>" placeholder="p. ej. señales, prioridad" />
      </div>

      <div class="flex-between">
        <a href="/cuaderno" class="btn fantasma">Cancelar</a>
        <button type="submit" class="btn"><i data-lucide="save" class="icon"></i> Guardar nota</button>
      </div>
    </form>
  </div>
</body>
</html>
