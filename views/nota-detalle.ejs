<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: nota.titulo || 'Nota' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container">

    <div class="flex-between" style="margin-bottom:12px;">
      <h1><%= nota.titulo || 'Nota sin título' %></h1>
      <span class="badge <%= nota.origen === 'ia' ? 'ia' : 'neutro' %>">
        <%= nota.origen === 'ia' ? 'Del asistente' : (nota.origen === 'mixta' ? 'Mixta' : 'Manual') %>
      </span>
    </div>

    <div class="card">
      <% if (nota.pregunta_imagen) { %>
        <img class="pregunta-imagen" src="/images/preguntas/<%= nota.pregunta_imagen %>" alt="Imagen de la pregunta relacionada" style="max-height:240px;" />
      <% } %>
      <p class="nota-cuerpo"><%= nota.contenido %></p>
    </div>

    <div class="card">
      <% if (nota.pregunta_enunciado) { %>
        <h2>Pregunta relacionada</h2>
        <p><%= nota.pregunta_enunciado %>
          <% if (nota.pregunta_id) { %><br /><a href="/cuaderno/nueva?pregunta_id=<%= nota.pregunta_id %>">Añadir otra nota a esta pregunta</a><% } %>
        </p>
      <% } %>
      <div>
        <% if (nota.tema_numero) { %><span class="etiqueta-pill">Tema <%= nota.tema_numero %> — <%= nota.tema_nombre %></span><% } %>
        <% if (nota.categoria) { %><span class="etiqueta-pill"><%= nota.categoria %></span><% } %>
        <% (nota.etiquetas || '').split(',').map(t=>t.trim()).filter(Boolean).forEach(function(t){ %>
          <span class="etiqueta-pill">#<%= t %></span>
        <% }) %>
      </div>
      <p class="text-muted mt-2" style="margin:0;">Creada: <%= nota.creado_en %> · Actualizada: <%= nota.actualizado_en %></p>
    </div>

    <div class="flex-between">
      <a href="/cuaderno" class="btn secundario"><i data-lucide="arrow-left" class="icon"></i> Cuaderno</a>
      <div style="display:flex; gap:10px;">
        <a href="/cuaderno/<%= nota.id %>/editar" class="btn secundario"><i data-lucide="pencil" class="icon"></i> Editar</a>
        <form method="POST" action="/cuaderno/<%= nota.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta nota? No se puede deshacer.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn peligro"><i data-lucide="trash-2" class="icon"></i> Eliminar</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
