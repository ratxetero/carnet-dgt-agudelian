<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Inicio' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container-ancho">

    <div class="flex-between mt-1" style="margin-bottom:14px;">
      <div>
        <div class="eyebrow">Panel</div>
        <h1>Hola, <%= user.username %></h1>
      </div>
      <a href="/test/nuevo" class="btn"><i data-lucide="play" class="icon"></i> Nuevo test</a>
    </div>

    <div class="franja-indicadores">
      <div class="indicador">
        <span class="valor"><%= resumen.totalTests %></span>
        <span class="etiqueta">Tests</span>
      </div>
      <div class="indicador">
        <span class="valor"><%= resumen.porcentajeAcierto %>%</span>
        <span class="etiqueta">Acierto</span>
      </div>
      <div class="indicador">
        <span class="valor" style="color:var(--success);"><%= resumen.totalAprobados %></span>
        <span class="etiqueta">Aptos</span>
      </div>
      <div class="indicador">
        <span class="valor" style="color:var(--danger);"><%= resumen.totalSuspensos %></span>
        <span class="etiqueta">No aptos</span>
      </div>
    </div>

    <% if (totalFallos > 0) { %>
      <div class="card" style="border-left:2px solid var(--warning); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
        <div class="flex-icon">
          <i data-lucide="alert-triangle" class="icon" style="color:var(--warning);"></i>
          <span style="font-size:0.88rem;"><strong><%= totalFallos %></strong> pregunta<%= totalFallos===1?'':'s' %> pendiente<%= totalFallos===1?'':'s' %> de repasar</span>
        </div>
        <a href="/test/nuevo" class="btn secundario" style="padding:7px 12px; font-size:0.82rem; min-height:auto;">Repasar</a>
      </div>
    <% } %>

    <div class="lista-accesos">
      <a href="/test/nuevo">
        <i data-lucide="square-pen" class="icon"></i>
        <span class="texto"><strong>Nuevo test</strong><span>Aleatorio, por tema, simulacro o repaso</span></span>
        <i data-lucide="chevron-right" class="icon chevron"></i>
      </a>
      <a href="/cuaderno">
        <i data-lucide="notebook-text" class="icon"></i>
        <span class="texto"><strong>Cuaderno</strong><span>Tus notas de estudio</span></span>
        <i data-lucide="chevron-right" class="icon chevron"></i>
      </a>
      <a href="/manual">
        <i data-lucide="book-open" class="icon"></i>
        <span class="texto"><strong>Manual</strong><span>Consulta el manual teórico</span></span>
        <i data-lucide="chevron-right" class="icon chevron"></i>
      </a>
      <a href="/stats">
        <i data-lucide="bar-chart-3" class="icon"></i>
        <span class="texto"><strong>Estadísticas</strong><span>Tu progreso por tema</span></span>
        <i data-lucide="chevron-right" class="icon chevron"></i>
      </a>
    </div>

    <div class="card">
      <h2>Últimos resultados</h2>
      <% if (!resumen.ultimos.length) { %>
        <div class="estado-vacio">
          <div class="icono-vacio"><i data-lucide="car-front" class="icon-lg"></i></div>
          <h3>Todavía no has hecho ningún test</h3>
          <p>Empieza con uno aleatorio para ver dónde estás.</p>
          <a href="/test/nuevo" class="btn">Empezar</a>
        </div>
      <% } else { %>
        <div style="overflow-x:auto;">
        <table class="tabla-simple">
          <thead><tr><th>Fecha</th><th>Tipo</th><th>Preguntas</th><th>Aciertos</th><th>Fallos</th><th>Resultado</th></tr></thead>
          <tbody>
            <% resumen.ultimos.forEach(function(t){ %>
              <tr>
                <td><%= t.finalizado_en %></td>
                <td><%= t.tipo %></td>
                <td><%= t.num_preguntas %></td>
                <td><%= t.aciertos %></td>
                <td><%= t.fallos %></td>
                <td>
                  <% if (t.aprobado) { %><span class="badge ok"><i data-lucide="check" class="icon-sm"></i> Apto</span>
                  <% } else { %><span class="badge fail"><i data-lucide="x" class="icon-sm"></i> No apto</span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
        <p class="mt-2"><a href="/stats" class="flex-icon" style="display:inline-flex;">Ver estadísticas completas <i data-lucide="arrow-right" class="icon-sm"></i></a></p>
      <% } %>
    </div>

    <% if (examenes.length) { %>
      <p class="text-muted"><%= examenes.length %> simulacros de 30 preguntas disponibles en formato de examen oficial DGT.</p>
    <% } %>
  </div>
</body>
</html>
