<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { titulo: 'Estadísticas' }) %></head>
<body>
  <%- include('partials/nav') %>
  <div class="container-ancho">

    <div class="cabecera-alumno">
      <span class="rol">Progreso</span>
      <h1>Estadísticas</h1>
    </div>

    <div class="errores" id="stats-error" style="display:none;"></div>

    <div class="estado-vacio" id="stats-vacio" style="display:none;">
      <div class="icono-vacio"><i data-lucide="bar-chart-3" class="icon-lg"></i></div>
      <h3>Aún no hay datos</h3>
      <p>En cuanto termines tu primer test (aleatorio, por tema, simulacro o repaso) aquí verás tu progreso.</p>
      <a href="/test/nuevo" class="btn">Hacer mi primer test</a>
    </div>

    <div id="stats-contenido" style="display:none;">

      <div class="franja-indicadores" id="stats-marcador">
        <div class="indicador"><span class="valor" id="v-tests">–</span><span class="etiqueta">Tests</span></div>
        <div class="indicador"><span class="valor" id="v-acierto">–</span><span class="etiqueta">Acierto</span></div>
        <div class="indicador"><span class="valor" id="v-aptos" style="color:var(--success);text-shadow:none;">–</span><span class="etiqueta">Aptos</span></div>
        <div class="indicador"><span class="valor" id="v-noaptos" style="color:var(--danger);text-shadow:none;">–</span><span class="etiqueta">No aptos</span></div>
      </div>

      <div class="card">
        <div class="hud-etiquetas">
          <span>Acierto acumulado</span>
          <b id="v-acierto-2">–</b>
        </div>
        <div class="barra-energia" id="barra-global">
          <div class="pista"><div class="carga" id="carga-global" style="width:0%"></div></div>
        </div>
        <div class="reparto mt-2" id="reparto-respuestas"></div>
        <div class="leyenda-reparto" id="leyenda-respuestas"></div>
      </div>

      <div class="card">
        <h2>Aciertos por tema</h2>
        <p class="text-muted" style="margin-top:-2px;">Solo se listan los temas en los que ya has respondido preguntas.</p>
        <div id="lista-temas">
          <div class="stats-carga">
            <div class="skeleton skeleton-linea corta"></div>
            <div class="skeleton alto"></div>
            <div class="skeleton skeleton-linea corta"></div>
            <div class="skeleton alto"></div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>Simulacros oficiales</h2>
        <div style="overflow-x:auto;">
          <table class="tabla-simple" id="tabla-oficiales">
            <thead><tr><th>Simulacro</th><th>Intentos</th><th>Mejor</th><th>Apto</th></tr></thead>
            <tbody><tr><td colspan="4" class="text-muted">Cargando…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/stats.js"></script>
</body>
</html>
